# Copy relevant values into .env.local

# Cloud agents (orchestrator) + cloud project upload. Catalog stays on when 0.
# CLOUD_ENABLED=1
# CLOUD_ENABLED=0

ORCHESTRATOR_URL=http://127.0.0.1:9000
# Required — must NOT be "dev-secret". Generate: openssl rand -hex 32
ORCHESTRATOR_SECRET=

# Max concurrent cloud agent sessions per user (default 3)
# MAX_CLOUD_SESSIONS_PER_USER=3

# Cloudflare R2 (S3-compatible) — used for cloud project saves
R2_BUCKET_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mylo

# AI — platform fallback (optional if every user brings their own key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated allowlist (defaults to a small Gemini set if unset)
# GEMINI_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-pro

# NextAuth — required
# NEXTAUTH_SECRET=   # or AUTH_SECRET — same value; required in production
# Local:
# NEXTAUTH_URL=http://localhost:3000
# Production (must be your real HTTPS origin, NOT localhost):
# NEXTAUTH_URL=https://your-domain.com
# Google/GitHub console redirect URIs must include:
#   {NEXTAUTH_URL}/api/auth/callback/google
#   {NEXTAUTH_URL}/api/auth/callback/github
# GOOGLE_ID=
# GOOGLE_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=

# BYOK — required to store user LLM keys (32-byte hex). Generate: openssl rand -hex 32
BYOK_MASTER_KEY=

# Optional: wrap DEKs with AWS KMS instead of BYOK_MASTER_KEY (needs AWS credentials)
# BYOK_KMS_KEY_ID=arn:aws:kms:region:account:key/...

# Optional AI rate limit (requests per user per minute, default 30)
# AI_RATE_LIMIT_PER_MINUTE=30
